{
  "builds": [
    {
      "src": "santy/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "includeFiles": "templates/**,static/**,app.json" }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "(.*)",
      "dest": "santy/wsgi.py"
    }
  ]
}