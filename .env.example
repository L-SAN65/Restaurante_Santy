# Copia este archivo a .env y completa los valores de Supabase
# https://supabase.com/dashboard -> Project Settings -> Database -> Connection string

DEBUG=True
SECRET_KEY=dev-only-key-cambiar-en-produccion
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# Dejar vacío para usar SQLite local. Para Supabase usa:
# DATABASE_URL=postgresql://postgres:[TU_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=

# Realtime (KDS / estados de mesa): se resuelve con Supabase Realtime directo al
# navegador (anon key + RLS), no con Django Channels. En Vercel las variables
# DEBUG/SECRET_KEY/ALLOWED_HOSTS/DATABASE_URL se definen en Project Settings;
# VERCEL_ENV y VERCEL son inyectadas por Vercel (DEBUG se fuerza a False ahí).
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_ANON_KEY=eyJ...
# Storage persistente para imágenes de platillos (Vercel). Crear bucket público en Supabase Dashboard -> Storage -> New bucket (ej. platos)
# y generar S3 Access Keys en Project Settings -> Storage -> S3 Keys (o Database -> S3).
# Si no se configuran, fallback a filesystem (/tmp en Vercel, efímero).
# SUPABASE_URL=https://koaaqiuyqcqotzdvyhcz.supabase.co
# AWS_ACCESS_KEY_ID=<supabase s3 access key>
# AWS_SECRET_ACCESS_KEY=<supabase s3 secret>
# AWS_STORAGE_BUCKET_NAME=platos
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=https://koaaqiuyqcqotzdvyhcz.supabase.co/storage/v1/s3  # opcional, se deriva de SUPABASE_URL